[
  {
    "label": "Send selection to Claude Code",
    "command": "zed-claude-bridge ipc-send-at-mention --workspace \"$WS\" --file-path \"$FP\" --cursor-row \"$ROW\" --text \"$TEXT\"",
    "env": {
      "WS": "$ZED_WORKTREE_ROOT",
      "FP": "$ZED_FILE",
      "ROW": "$ZED_ROW",
      "TEXT": "$ZED_SELECTED_TEXT"
    },
    "use_new_terminal": false,
    "allow_concurrent_runs": true,
    "reveal": "never"
  }
]
